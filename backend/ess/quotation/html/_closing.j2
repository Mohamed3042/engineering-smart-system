{%- if layout == "letter" %}
<div class="letter-closing" data-closing>
<div class="yours">{{ closing.signoff }}</div>
<div class="sigwrap">
{%- if closing.signature.src %}<img class="sig" src="{{ closing.signature.src }}" alt="">{% endif %}
{%- if chrome.draft and not closing.signature.src %}<span class="unsigned">{% if rtl %}غير موقّع – مسودة{% else %}Not signed – draft{% endif %}</span>{% endif %}
<div class="signee"><b>{{ closing.signature.name }}</b>{% for line in closing.signature.lines %}<div>{{ line }}</div>{% endfor %}</div>
</div>
</div>
{%- else %}
<div class="closing" data-closing>
{%- for line in closing.lines %}
<p>{{ line }}</p>
{%- endfor %}
<p>{{ closing.signoff }}</p>
<div class="signature">
{%- if closing.signature.src %}<img class="sig" src="{{ closing.signature.src }}" alt="">{% endif %}
{%- if chrome.draft and not closing.signature.src %}<span class="unsigned">{% if rtl %}غير موقّع – مسودة{% else %}Not signed – draft{% endif %}</span>{% endif %}
<div class="identity"><b>{{ closing.signature.name }}</b>{% if closing.signature.title %}<br><span>{{ closing.signature.title }}</span>{% endif %}</div>
</div>
</div>
{%- endif %}
